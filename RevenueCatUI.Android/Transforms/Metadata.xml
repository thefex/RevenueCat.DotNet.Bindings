  <!-- ===== Fix ConstraintLayoutBaseScope duplicate method names =====
       Kotlin inline-class methods are mangled with a suffix (e.g. -0680j_4).
       Both the plain and mangled variants take a single float, so the generator
       produces two C# methods with the same name. Rename the offset-based
       (mangled) variants so they don't clash with the fraction-based ones. -->
  <attr path="/api/package[@name='androidx.constraintlayout.compose']/class[@name='ConstraintLayoutBaseScope']/method[@name='createGuidelineFromAbsoluteLeft-0680j_4']" name="managedName">CreateGuidelineFromAbsoluteLeftWithOffset</attr>
  <attr path="/api/package[@name='androidx.constraintlayout.compose']/class[@name='ConstraintLayoutBaseScope']/method[@name='createGuidelineFromAbsoluteRight-0680j_4']" name="managedName">CreateGuidelineFromAbsoluteRightWithOffset</attr>
  <attr path="/api/package[@name='androidx.constraintlayout.compose']/class[@name='ConstraintLayoutBaseScope']/method[@name='createGuidelineFromBottom-0680j_4']" name="managedName">CreateGuidelineFromBottomWithOffset</attr>
  <attr path="/api/package[@name='androidx.constraintlayout.compose']/class[@name='ConstraintLayoutBaseScope']/method[@name='createGuidelineFromEnd-0680j_4']" name="managedName">CreateGuidelineFromEndWithOffset</attr>
  <attr path="/api/package[@name='androidx.constraintlayout.compose']/class[@name='ConstraintLayoutBaseScope']/method[@name='createGuidelineFromStart-0680j_4']" name="managedName">CreateGuidelineFromStartWithOffset</attr>
  <attr path="/api/package[@name='androidx.constraintlayout.compose']/class[@name='ConstraintLayoutBaseScope']/method[@name='createGuidelineFromTop-0680j_4']" name="managedName">CreateGuidelineFromTopWithOffset</attr>

  <!-- ===== Fix PurchaseLogicWithCallback missing Invoker member (10.17.0) =====
       PurchaseLogic gained a DEFAULT interface method
       performPurchase(Activity, PaywallPurchaseLogicParams, Continuation).
       PurchaseLogicWithCallback doesn't override it in Java (inherits the default),
       so the generator emits it as abstract in the C# class but never implements it
       in PurchaseLogicWithCallbackInvoker → CS0534.
       Fix: remove the default method from the binding. At runtime the Java default
       implementation still runs and delegates to the abstract
       performPurchase(Activity, Package, Continuation), which C# implementors
       provide — so no behavior is lost. -->
  <remove-node path="/api/package[@name='com.revenuecat.purchases.ui.revenuecatui']/interface[@name='PurchaseLogic']/method[@name='performPurchase' and parameter[2][contains(@type,'PaywallPurchaseLogicParams')]]" />

  <!-- ===== Fix ActivityResultContract abstract method mismatches =====
       ShowCustomerCenter extends ActivityResultContract but the newer AndroidX Activity
       NuGet changed abstract signatures (Object instead of typed params/returns).
       Easiest fix: remove the class from bindings — it's an internal Android contract
       not intended to be subclassed from C#. -->
  <remove-node path="/api/package[@name='com.revenuecat.purchases.ui.revenuecatui.customercenter']/class[@name='ShowCustomerCenter']" />

