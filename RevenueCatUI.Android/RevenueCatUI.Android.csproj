    <PackageReference Include="Xamarin.AndroidX.Core.Core.Ktx" Version="1.19.0.1" />
  </ItemGroup>

  <ItemGroup>
    <TransformFile Include="Transforms\Metadata.xml" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RevenueCat.Android\RevenueCat.Android.csproj" JavaArtifact="com.revenuecat.purchases:purchases:11.0.0" />
  </ItemGroup>

</Project>
