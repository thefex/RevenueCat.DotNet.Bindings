    <PackageReference Include="Xamarin.AndroidX.Compose.UI.Util" Version="1.11.4" />
    <PackageReference Include="Xamarin.AndroidX.ConstraintLayout" Version="2.2.1.5" />
    <PackageReference Include="Xamarin.AndroidX.ExifInterface" Version="1.4.2.2" />
    <PackageReference Include="Xamarin.AndroidX.Fragment.Ktx" Version="1.9.0" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.Runtime.Ktx" Version="2.11.0.1" />
