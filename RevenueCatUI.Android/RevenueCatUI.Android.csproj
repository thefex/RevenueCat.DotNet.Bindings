<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>true</ImplicitUsings>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>RevenueCatUI.DotNet.Android.Bindings</PackageId>
    <Version>11.0.0</Version>
    <Authors>Przemysław Raciborski [thefex]</Authors>
    <Description>.net-android bindings for RevenueCat UI. This package is not affiliated with RevenueCat at all.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/RevenueCat/purchases-android</RepositoryUrl>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <Version>11.0.0-rc1</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- VerifyDependencies="false": purchases-ui v10 POM imports androidx.compose:compose-bom
         via dependencyManagement, which lives on Google Maven (not Central). The verifier
         would try to fetch it from Central and get 404. All deps are declared explicitly
         as PackageReferences so verification adds no value here. -->
    <AndroidMavenLibrary Include="com.revenuecat.purchases:purchases-ui" Version="11.0.0" VerifyDependencies="false" />
    <!-- No MS-maintained NuGet for these deps -->    
    <AndroidMavenLibrary Include="dev.drewhamilton.poko:poko-annotations" Version="0.20.2" Bind="false" />
    <AndroidLibrary Include="libs/constraintlayout-compose-1.1.1.aar" Bind="false" JavaArtifact="androidx.constraintlayout:constraintlayout-compose:1.1.1" />
    <AndroidLibrary Include="libs/constraintlayout-compose-android-1.1.1.aar" Bind="false" JavaArtifact="androidx.constraintlayout:constraintlayout-compose-android:1.1.1" />
    
    <AndroidLibrary Include="libs/ui-text-google-fonts-1.11.4.aar" Bind="false" JavaArtifact="androidx.compose.ui:ui-text-google-fonts:1.11.4" />
    
    <AndroidMavenLibrary Include="io.coil-kt:coil-compose" Version="2.4.0" Bind="false" />
    <AndroidMavenLibrary Include="io.coil-kt:coil-svg" Version="2.4.0" Bind="false" />
    <AndroidMavenLibrary Include="io.coil-kt:coil" Version="2.4.0" Bind="false" />
    <AndroidMavenLibrary Include="io.coil-kt:coil-compose-base" Version="2.4.0" Bind="false" />
    <AndroidMavenLibrary Include="io.coil-kt:coil-base" Version="2.4.0" Bind="false" /> 
    <AndroidMavenLibrary Include="org.commonmark:commonmark" Version="0.21.0" Bind="false" />
    <AndroidMavenLibrary Include="org.commonmark:commonmark-ext-gfm-strikethrough" Version="0.21.0" Bind="false" />
    <AndroidMavenLibrary Include="com.caverock:androidsvg-aar" Version="1.4" Bind="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Square.OkHttp3" Version="5.3.2.2" />
    <PackageReference Include="Square.OkIO" Version="3.16.4.2" />
    <PackageReference Include="Xamarin.AndroidX.Activity.Compose" Version="1.13.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Annotation" Version="1.10.0.1" />
    <PackageReference Include="Xamarin.AndroidX.AppCompat.AppCompatResources" Version="1.7.1.3" />
    <PackageReference Include="Xamarin.AndroidX.Browser" Version="1.9.0.2" />
    <PackageReference Include="Xamarin.AndroidX.Collection" Version="1.6.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Compose.Foundation" Version="1.11.4" />
    <PackageReference Include="Xamarin.AndroidX.Compose.Material" Version="1.11.4" />
    <PackageReference Include="Xamarin.AndroidX.Compose.Material3" Version="1.4.0.2" />
    <PackageReference Include="Xamarin.AndroidX.Compose.Material3Android" Version="1.4.0.2" />
    <PackageReference Include="Xamarin.AndroidX.Compose.Material3.Adaptive" Version="1.2.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Compose.Material3.Adaptive.Layout" Version="1.2.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Compose.Material3.Adaptive.Navigation" Version="1.2.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Compose.UI" Version="1.11.4" />
    <PackageReference Include="Xamarin.AndroidX.Compose.UI.Graphics" Version="1.11.4" />
    <PackageReference Include="Xamarin.AndroidX.Compose.UI.Text" Version="1.11.4" />
