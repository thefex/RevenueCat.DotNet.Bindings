<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0-ios</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>true</ImplicitUsings>
        <IsBindingProject>true</IsBindingProject>
        <SupportedOSPlatformVersion>14.2</SupportedOSPlatformVersion>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <PackageId>RevenueCat.DotNet.Bindings</PackageId>
        <Version>5.67.0</Version>
        <Authors>Przemysław Raciborski [thefex]</Authors>
        <Description>.net-ios bindings for RevenueCat. This package is not affiliated with RevenueCat at all.</Description>
        <Configurations>Debug;Release;AppStore;AdHoc</Configurations>
        <Platforms>AnyCPU</Platforms>
        <RuntimeIdentifiers>ios-arm64; iossimulator-arm64</RuntimeIdentifiers>
    </PropertyGroup>
    
    <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
        <Version>5.67.0-rc1</Version>
    </PropertyGroup>

    <ItemGroup>
        <ObjcBindingApiDefinition Include="ApiDefinitions.cs"/>
        <ObjcBindingCoreSource Include="StructsAndEnums.cs"/>
    </ItemGroup>
    
    <ItemGroup Condition="'$(Configuration)' == 'Debug'">
        <NativeReference Include="RevenueCat-debug.xcframework">
            <Kind>Framework</Kind>
            <SmartLink>False</SmartLink>
        </NativeReference>
    </ItemGroup>
        
    <ItemGroup Condition="'$(Configuration)' != 'Debug'">
        <NativeReference Include="RevenueCat.xcframework" Condition="'$(Configuration)' != 'Debug'">
            <Kind>Framework</Kind>
            <SmartLink>False</SmartLink>
        </NativeReference>
    </ItemGroup>

</Project>
