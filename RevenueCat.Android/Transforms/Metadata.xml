  <!-- ===== Fix interface return type mismatches =====
       IStoreProduct.PurchasingData requires IPurchasingData; AmazonStoreProduct returns concrete AmazonPurchasingData.
       ISubscriptionOption.InstallmentsInfo requires IInstallmentsInfo; GoogleSubscriptionOption returns concrete GoogleInstallmentsInfo. -->
  <attr path="/api/package[@name='com.revenuecat.purchases.amazon']/class[@name='AmazonStoreProduct']/method[@name='getPurchasingData']" name="managedReturn">Com.Revenuecat.Purchases.Models.IPurchasingData</attr>
