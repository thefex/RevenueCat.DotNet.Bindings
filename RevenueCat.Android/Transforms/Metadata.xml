  <!-- ===== Fix KotlinX Serialization interface mismatches =====
       IKSerializer<T> covariance: deserialize returns T, but IDeserializationStrategy requires Object.
       serialize takes T, but ISerializationStrategy requires Object. -->
  <attr path="/api/package[@name='com.revenuecat.purchases.paywalls']/class[@name='PaywallColor.Serializer']/method[@name='deserialize']" name="managedReturn">Java.Lang.Object</attr>
  <attr path="/api/package[@name='com.revenuecat.purchases.paywalls']/class[@name='PaywallColor.Serializer']/method[@name='serialize' and count(parameter)=2]/parameter[2]" name="type">java.lang.Object</attr>

